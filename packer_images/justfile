# packer_images — build qcow2 VM images with packer and install them into libvirt.
# Pass a template dir name from qemu_images/ (default: ubuntu2404).
# Use `just --dry-run <recipe>` to print commands without running them.

set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory()
images := root / "qemu_images"
output := root / "output"
default_template := "ubuntu2404"

# Consumed by packer (PKR_VAR_*) and by envsubst in user-data.tpl
export PKR_VAR_username := "packer"
export PKR_VAR_password := "packer"

default:
    @just --list

# List available templates
templates:
    @ls -1 "{{ images }}"

# Render user-data, packer build; push to the store when config.yml has server: (and it answers), else copy to $VMTOOL_IMAGE_DIR (default <repo>/images/)
generate template=default_template: (_check-template template)
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf "{{ output / template }}"
    cd "{{ images / template / "http" }}" && PKR_VAR_distro="{{ template }}" PKR_VAR_hashedpassword="$(openssl passwd -6 "$PKR_VAR_password")" envsubst < user-data.tpl > user-data
    cd "{{ images / template }}" && packer init .
    cd "{{ images / template }}" && PKR_VAR_distro="{{ template }}" PKR_VAR_output_directory="{{ output / template }}" packer build .
    img="{{ output / template / template }}"
    repo="{{ root }}/.."
    # S12: vmtool reads config.yml in its working directory (the repo root) and
    # the store token itself. With server: set, push as <template>.qcow2, the
    # name the copy below gives, so a create resolves it in both modes.
    if [[ -x "$repo/vmtool" ]] && grep -Eq '^server:' "$repo/config.yml" 2>/dev/null; then
        log="$(mktemp)"
        if (cd "$repo" && ./vmtool images push --name "{{ template }}.qcow2" "$img") 2>&1 | tee "$log"; then
            rm -f "$log"
            echo "pushed {{ template }}.qcow2 to the store"
            exit 0
        fi
        # "no store in use": the store did not answer (unreachable or no token); nothing was sent.
        # Any other failure (digest or size mismatch, store error) fails the recipe; the image stays in output/.
        if grep -q 'no store in use' "$log"; then
            rm -f "$log"
            echo "store did not answer; falling back to image_dir" >&2
        else
            rm -f "$log"
            echo "push to the store failed; the image is at $img" >&2
            exit 1
        fi
    elif ! grep -Eq '^server:' "$repo/config.yml" 2>/dev/null; then
        echo "no server: in config.yml; copying to image_dir" >&2
    else
        echo "no built $repo/vmtool to push with; falling back to image_dir" >&2
    fi
    # vmtool finds base images in image_dir (config.yml); set that to this folder.
    # Copy under a temp name, then mv, so a reader never sees a half file.
    dir="${VMTOOL_IMAGE_DIR:-{{ root }}/../images}" && mkdir -p "$dir" && cp "{{ output / template / template }}" "$dir/.{{ template }}.qcow2.tmp" && mv -f "$dir/.{{ template }}.qcow2.tmp" "$dir/{{ template }}.qcow2" && echo "installed $dir/{{ template }}.qcow2"

# Render user-data, packer init + validate (offline; no build, no sudo, output/ untouched)
validate template=default_template: (_check-template template)
    cd "{{ images / template / "http" }}" && PKR_VAR_distro="{{ template }}" PKR_VAR_hashedpassword="$(openssl passwd -6 "$PKR_VAR_password")" envsubst < user-data.tpl > user-data
    cd "{{ images / template }}" && packer init .
    cd "{{ images / template }}" && packer validate -var distro="{{ template }}" -var username="$PKR_VAR_username" -var password="$PKR_VAR_password" -var output_directory="$(mktemp -u -t packer-validate-XXXXXX)" .

# Shape-check every template and the recipes, then validate every template in qemu_images/
check:
    #!/usr/bin/env bash
    set -uo pipefail

    # --- shape assertions -------------------------------------------------
    # Each check_* takes a template dir name and calls fail "<template>" "<what>"
    # for each thing missing. Add new checks as functions and list them in
    # shape_checks below.
    shape_failures=()
    fail() { shape_failures+=("$1: $2"); }

    # Text of the template's last provisioner block: from the last line that
    # opens a provisioner to the build block's closing brace (column 0).
    last_provisioner() {
        awk '/^[[:space:]]*provisioner "/ { buf = ""; on = 1 }
             on { buf = buf $0 "\n" }
             /^}/ { on = 0 }
             END { printf "%s", buf }' "$1"
    }

    check_efi_boot() {
        grep -Eq '^[[:space:]]*efi_boot[[:space:]]*=[[:space:]]*true' "{{ images }}/$1/template.pkr.hcl" \
            || fail "$1" "source \"qemu\" lacks efi_boot = true"
    }

    check_fallback_loader() {
        local last
        last="$(last_provisioner "{{ images }}/$1/template.pkr.hcl")"
        [[ "$last" =~ ^[[:space:]]*provisioner[[:space:]]+\"shell\" ]] \
            || fail "$1" "last provisioner is not a shell provisioner"
        [[ "$last" == *"/boot/efi/EFI/BOOT/BOOTX64.EFI"* ]] \
            || fail "$1" "last provisioner lacks the BOOTX64.EFI guard"
        [[ "$last" == *"grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram"* ]] \
            || fail "$1" "last provisioner lacks the fallback-loader grub-install line"
    }

    # C3: the image ends clean for cloud-init. The last provisioner waits for
    # the build VM's own cloud-init, then cleans it as its very last inline line.
    check_clean_for_cloud_init() {
        local last lastline pre
        last="$(last_provisioner "{{ images }}/$1/template.pkr.hcl")"
        [[ "$last" == *"cloud-init clean --machine-id"* ]] \
            || { fail "$1" "last provisioner lacks cloud-init clean --machine-id"; return; }
        [[ "$last" == *"cloud-init status --wait"* ]] \
            || fail "$1" "last provisioner lacks cloud-init status --wait"
        pre="${last%%cloud-init clean*}"
        [[ "$pre" == *"cloud-init status --wait"* ]] \
            || fail "$1" "cloud-init status --wait is not before cloud-init clean"
        # last non-blank, non-bracket line of the block must be the clean
        lastline="$(printf '%s' "$last" | grep -E '^[[:space:]]*"' | tail -n 1)"
        [[ "$lastline" == *"cloud-init clean --machine-id"* ]] \
            || fail "$1" "cloud-init clean --machine-id is not the last inline line"
    }

    # C14: the image ships no 127.0.1.1 line. The installer's names the image,
    # and cloud-init (manage_etc_hosts: localhost) appends its own beside it
    # instead of replacing it. The delete runs before cloud-init clean.
    check_no_installer_hosts_line() {
        local last pre
        local line="sudo sed -i '/^127[.]0[.]1[.]1[[:space:]]/d' /etc/hosts"
        last="$(last_provisioner "{{ images }}/$1/template.pkr.hcl")"
        [[ "$last" == *"\"$line\""* ]] \
            || { fail "$1" "last provisioner lacks the /etc/hosts 127.0.1.1 delete"; return; }
        pre="${last%%cloud-init clean*}"
        [[ "$pre" == *"\"$line\""* ]] \
            || fail "$1" "the /etc/hosts 127.0.1.1 delete is not before cloud-init clean"
    }

    check_vmtool_cfg() {
        local f="{{ images }}/$1/template.pkr.hcl"
        grep -q 'files/99-vmtool.cfg' "$f" \
            || fail "$1" "does not install files/99-vmtool.cfg"
        grep -q '/etc/cloud/cloud.cfg.d/99-vmtool.cfg' "$f" \
            || fail "$1" "does not install to /etc/cloud/cloud.cfg.d/99-vmtool.cfg"
    }

    # Nothing may leave cloud-init disabled: not the template, not user-data.tpl.
    check_cloud_init_not_disabled() {
        local f
        for f in "{{ images }}/$1/template.pkr.hcl" "{{ images }}/$1"/http/user-data.tpl; do
            [[ -e "$f" ]] || continue
            ! grep -q 'cloud-init\.disabled' "$f" \
                || fail "$1" "$(basename "$f") touches cloud-init.disabled"
        done
    }

    # One shared netplan file (files/99-wildcard.yaml) installed by every
    # template. No template may carry its own copy (any yaml under its dir) or
    # write one inline (a user-data.tpl with a netplan write_files path or an
    # ethernets: block).
    check_netplan_shared() {
        local d="{{ images }}/$1" f
        while IFS= read -r f; do
            fail "$1" "carries its own netplan/yaml file: ${f#"$d"/}"
        done < <(find "$d" \( -name '*.yaml' -o -name '*.yml' \) -type f | sort)
        for f in "$d"/http/user-data.tpl; do
            [[ -e "$f" ]] || continue
            ! grep -Ev '^[[:space:]]*#' "$f" | grep -Eq 'path:[[:space:]]*/etc/netplan|ethernets:' \
                || fail "$1" "$(basename "$f") writes an inline netplan"
        done
        grep -q '\.\./\.\./files/99-wildcard\.yaml' "$d/template.pkr.hcl" \
            || fail "$1" "does not take the shared ../../files/99-wildcard.yaml"
        grep -Eq 'install -m 0?600 [^"]*/etc/netplan/99-wildcard\.yaml' "$d/template.pkr.hcl" \
            || fail "$1" "does not install it to /etc/netplan/99-wildcard.yaml with mode 0600"
    }

    # C15: a rolling image URL (/current/) is republished in place, so a pinned
    # checksum goes stale. Such a template must read its sum from a file
    # (packer's file:<url> form). A URL without /current/ may pin any sum.
    check_rolling_url_checksum() {
        local f="{{ images }}/$1/template.pkr.hcl" sum
        grep -Eq '^[[:space:]]*iso_url[[:space:]]*=[[:space:]]*"[^"]*/current/' "$f" || return 0
        while IFS= read -r sum; do
            [[ "$sum" == file:* ]] \
                || fail "$1" "rolling iso_url (/current/) needs a file: checksum, not a pinned value"
        done < <(sed -nE 's/^[[:space:]]*iso_checksum[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$f")
        grep -Eq '^[[:space:]]*iso_checksum[[:space:]]*=' "$f" \
            || fail "$1" "rolling iso_url (/current/) needs a file: checksum, not a pinned value"
    }

    # I1: /tmp stays on disk (26.04's systemd would mount it as a tmpfs) and is
    # emptied at every boot, as 24.04 does. The template masks tmp.mount in its
    # last provisioner, before cloud-init clean, and without --now (the build
    # VM's provisioner scripts live in /tmp). It installs the shared tmpfiles
    # rule files/00-vmtool-tmp.conf, which must sort before the release's
    # tmp.conf.
    check_tmp_on_disk() {
        local f="{{ images }}/$1/template.pkr.hcl" last pre
        local install="sudo install -m 0644 /tmp/00-vmtool-tmp.conf /etc/tmpfiles.d/00-vmtool-tmp.conf"
        local mask='"sudo systemctl mask tmp.mount",'
        grep -q '\.\./\.\./files/00-vmtool-tmp\.conf' "$f" \
            || fail "$1" "does not take the shared ../../files/00-vmtool-tmp.conf"
        grep -qF "\"$install\"," "$f" \
            || fail "$1" "does not install it to /etc/tmpfiles.d/00-vmtool-tmp.conf with mode 0644"
        ! grep -q 'mask --now tmp\.mount' "$f" \
            || fail "$1" "masks tmp.mount with --now (would unmount the build VM's /tmp under packer)"
        last="$(last_provisioner "$f")"
        if [[ "$last" == *"$mask"* ]]; then
            pre="${last%%cloud-init clean*}"
            [[ "$pre" == *"$mask"* ]] \
                || fail "$1" "systemctl mask tmp.mount is not before cloud-init clean"
        else
            fail "$1" "last provisioner lacks \"sudo systemctl mask tmp.mount\" (/tmp would stay a tmpfs on 26.04)"
        fi
    }

    if [[ -f "{{ root }}/files/00-vmtool-tmp.conf" ]]; then
        grep -Eq '^D /tmp 1777 root root 30d$' "{{ root }}/files/00-vmtool-tmp.conf" \
            || shape_failures+=("files/00-vmtool-tmp.conf lacks the line \"D /tmp 1777 root root 30d\"")
    else
        shape_failures+=("files/00-vmtool-tmp.conf is missing (the tmpfiles rule that empties /tmp at boot)")
    fi
    [[ -f "{{ root }}/files/99-vmtool.cfg" ]] || shape_failures+=("files/99-vmtool.cfg is missing")
    if [[ -f "{{ root }}/files/99-wildcard.yaml" ]]; then
        grep -Eq '^[[:space:]]+dhcp-identifier:[[:space:]]*mac[[:space:]]*$' "{{ root }}/files/99-wildcard.yaml" \
            || shape_failures+=("files/99-wildcard.yaml lacks dhcp-identifier: mac")
        # K2: take the search domain a vmtool network's DHCP sends, so a
        # one-word name (n2) resolves as n2.<network>.test. networkd's
        # default ignores the DHCP domain. Every template installs this one
        # file (check_netplan_shared), so this pins all seven.
        grep -Eq '^[[:space:]]+dhcp4-overrides:[[:space:]]*\{[[:space:]]*use-domains:[[:space:]]*true[[:space:]]*\}[[:space:]]*$' "{{ root }}/files/99-wildcard.yaml" \
            || shape_failures+=("files/99-wildcard.yaml lacks dhcp4-overrides: {use-domains: true} (one-word names would not resolve on vmtool networks)")
    else
        shape_failures+=("files/99-wildcard.yaml is missing")
    fi

    # W6: generate puts the image in vmtool's image_dir: ${VMTOOL_IMAGE_DIR:-<repo>/images}
    # as <template>.qcow2, with no sudo and no pool-refresh; the repo's
    # .gitignore lists images/. Runs once, not per template.
    check_generate_image_dir() {
        local body
        body="$(awk '/^generate / { on = 1; next } on && /^[^[:space:]]/ { on = 0 } on' "{{ justfile() }}")"
        # the source says ${VMTOOL_IMAGE_DIR:-<root>/../images}; <root> is a just interpolation
        [[ "$body" == *'VMTOOL_IMAGE_DIR:-'*'/../images}'* ]] \
            || shape_failures+=("generate does not copy into \${VMTOOL_IMAGE_DIR:-<repo>/images}")
        [[ "$body" != *sudo* ]] \
            || shape_failures+=("generate still uses sudo")
        [[ "$body" != *pool-refresh* ]] \
            || shape_failures+=("generate still runs pool-refresh")
        grep -Eq '^/?images/?$' "{{ root }}/../.gitignore" \
            || shape_failures+=(".gitignore does not list images/")
    }
    check_generate_image_dir

    # S12: with server: in config.yml, generate pushes the image to the store
    # (vmtool images push --name <template>.qcow2) before it copies to image_dir;
    # when the store does not answer it falls back to W6's copy and says so.
    # Neither path reads or passes a token (vmtool reads VMTOOL_SERVER_TOKEN itself).
    check_generate_store_push() {
        local body push copy
        body="$(awk '/^generate / { on = 1; next } on && /^[^[:space:]]/ { on = 0 } on' "{{ justfile() }}")"
        [[ "$body" == *'^server:'*config.yml* || "$body" == *config.yml*'^server:'* ]] \
            || shape_failures+=("generate does not look for server: in config.yml")
        [[ "$body" == *'images push'* ]] \
            || { shape_failures+=("generate does not run vmtool images push"); return; }
        [[ "$body" == *'--name'*'.qcow2'* ]] \
            || shape_failures+=("generate does not push under the name <template>.qcow2")
        [[ "$body" == *'no store in use'* ]] \
            || shape_failures+=("generate does not tell a store that did not answer from a failed push")
        [[ "$body" == *'falling back to image_dir'* ]] \
            || shape_failures+=("generate's fallback to the image_dir copy lost its line (\"falling back to image_dir\")")
        [[ "$body" == *'no server: in config.yml; copying to image_dir'* ]] \
            || shape_failures+=("generate copies to image_dir without a line when config.yml has no server:")
        [[ "$body" == *VMTOOL_IMAGE_DIR* ]] \
            || shape_failures+=("generate lost the image_dir copy the push falls back to")
        [[ "$body" != *VMTOOL_SERVER_TOKEN* && "$body" != *--token* && "$body" != *.env* ]] \
            || shape_failures+=("generate handles the store token (vmtool reads it itself)")
        push="${body%%images push*}"
        copy="${body%%VMTOOL_IMAGE_DIR*}"
        (( ${#push} < ${#copy} )) \
            || shape_failures+=("generate copies to image_dir before it tries the push")
    }
    check_generate_store_push

    # F3: the old entry script is gone and nothing names it. The docs and this
    # file say "just <recipe>"; packer_images/docs/LOG.md is append-only history
    # and is not read. The needle is built from two pieces so this file does
    # not match itself.
    check_no_run_script() {
        local needle='.''/run' f
        [[ ! -e "{{ root }}/run" ]] \
            || shape_failures+=("packer_images/run exists (the justfile replaced it; delete it)")
        for f in "{{ root }}/README.md" "{{ root }}/CLAUDE.md" "{{ justfile() }}"; do
            ! grep -qF -e "$needle" "$f" \
                || shape_failures+=("$(basename "$f") names the old $needle script")
        done
    }
    check_no_run_script

    # F3: update clones the image into a VM named host/<template>-update (a bare
    # name now means a metal machine) and never boots the cached image itself
    # (--noclone).
    check_update_clone() {
        local body
        body="$(awk '/^update / { on = 1; next } on && /^[^[:space:]]/ { on = 0 } on' "{{ justfile() }}")"
        [[ -n "$body" ]] \
            || { shape_failures+=("the justfile has no update recipe"); return; }
        [[ "$body" == *'$host/{{ "{{" }} template }}-update'* ]] \
            || shape_failures+=("update does not name the VM host/<template>-update")
        [[ "$body" != *--noclone* ]] \
            || shape_failures+=("update uses --noclone (it would boot the cached image itself)")
    }
    check_update_clone

    shape_checks=(check_efi_boot check_fallback_loader check_clean_for_cloud_init check_no_installer_hosts_line check_vmtool_cfg check_cloud_init_not_disabled check_netplan_shared check_rolling_url_checksum check_tmp_on_disk)

    for dir in "{{ images }}"/*/; do
        t="$(basename "$dir")"
        for c in "${shape_checks[@]}"; do "$c" "$t"; done
    done
    if (( ${#shape_failures[@]} )); then
        printf 'check: shape: %s\n' "${shape_failures[@]}" >&2
        exit 1
    fi

    # --- packer validate --------------------------------------------------
    failed=()
    for dir in "{{ images }}"/*/; do
        t="$(basename "$dir")"
        echo "== validate $t"
        "{{ just_executable() }}" -f "{{ justfile() }}" validate "$t" || failed+=("$t")
    done
    if (( ${#failed[@]} )); then
        echo "check: validate failed for: ${failed[*]}" >&2
        exit 1
    fi
    echo "check: ok"

# Smoke-boot a throwaway clone <host>/<template>-update of the image in image_dir (or the store); host defaults to this machine's name. No upgrade playbook is wired.
update template=default_template host="": (_check-template template)
    #!/usr/bin/env bash
    set -euo pipefail
    repo="{{ root }}/.."
    host="{{ host }}"
    [[ -n "$host" ]] || host="$("$repo/scripts/cert.sh" --local-name)"
    vm="$host/{{ template }}-update"
    cd "$repo"
    # a leftover from an earlier run; its absence is fine
    ./vmtool delete "$vm" 2>/dev/null || true
    ./vmtool create "$vm" "{{ template }}.qcow2"
    echo "$vm is a throwaway smoke boot of {{ template }}.qcow2 (an ordinary clone); delete it with: ./vmtool delete $vm"

# Delete build output for one template
clean template=default_template: (_check-template template)
    rm -rf "{{ output / template }}"

# Delete all build output
distclean:
    rm -rf "{{ output }}"

[private]
_check-template template:
    @[[ -d "{{ images / template }}" ]] || { echo "Error: invalid template '{{ template }}'. Available:" >&2; ls -1 "{{ images }}" >&2; exit 1; }
