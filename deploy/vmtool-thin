#!/bin/bash
# vmtool-thin: the one root-owned helper through which the vmtool daemon
# manages its LVM thin volumes.
#
#   sudo -n /usr/local/libexec/vmtool-thin <verb> <args>
#
# Installed by `just deploy` (scripts/deploy.sh) as root:root 0755, never
# owned by the vmtool user, with a sudoers rule that lets user vmtool run
# this one file as root. It is the only thing vmtool runs as root. The daemon
# may be compromised, so every argument is validated here and the helper acts
# only on what vmtool made:
#   - a volume group that holds a thin pool tagged vmtool_thinpool;
#   - thin logical volumes tagged vmtool_vol, vmtool_template or
#     vmtool_building (create and report excepted); never a pool, never an
#     untagged volume;
#   - thick (linear) logical volumes tagged vmtool_export, which only export
#     makes: remove, tag and send act on them, nothing else does;
#   - flat regular files in the image directory, whose path is rendered into
#     the installed copy by deploy (no environment can change it); import
#     reads them.
# It never runs lvm with caller-supplied options, never forces a removal,
# never builds a command from text, and runs qemu-img and dd only as user
# vmtool (setpriv), against device nodes it hands to vmtool for the
# duration, so they can reach only what vmtool can reach anyway (a qcow2
# file may name any backing file).
#
# Verbs (a refusal prints one line to stderr and exits non-zero):
#   report                                  lvs JSON over the VGs holding a pool
#   create VG POOL NAME BYTES TAG...        thin volume of BYTES
#   snapshot VG SRC NAME TAG...             thin snapshot of SRC, activated
#   extend VG NAME BYTES                    grow only (equal size: nothing)
#   remove VG NAME
#   rename VG OLD NEW
#   tag VG NAME +TAG|-TAG...
#   import VG NAME SRC                      qcow2 file -> the volume (raw)
#   export VG TEMPLATE NAME TAG...          template -> a new thick qcow2 volume
#   send VG NAME                            the export volume's qcow2 bytes -> stdout
#
# export: TEMPLATE is a vmtool_template thin volume. NAME is vmexp-<12 hex>
# and new. TAG... include vmtool_export and none of vmtool_vol,
# vmtool_template, vmtool_building, vmtool_thinpool, vmtool_bytes. It sizes
# the volume with `qemu-img measure` (fully allocated, rounded up to the VG's
# extent size), refuses before creating anything unless the VG's free space
# less that size leaves at least a tenth of the thin pool's size, makes the
# linear volume (never in the pool), converts the template into it as qcow2,
# runs `qemu-img check`, and adds the tag vmtool_bytes=<image-end-offset>.
# stdout carries qemu-img's progress lines (`    (12.34/100%)`, carriage-
# return separated) and nothing else. Any failure after the volume exists
# removes that volume (never the template). No room is one stderr line:
#   vmtool-thin: no room: need=<bytes> free=<bytes> reserve=<bytes>
# (need: the volume's size; free: the VG's free bytes; reserve: the tenth).
#
# send: NAME is a thick vmtool_export volume with exactly one vmtool_bytes=N
# tag, N no larger than the volume. Writes the first N bytes of the device to
# stdout, as user vmtool, and nothing else. N comes only from that tag.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
umask 022

pool_dir='@POOL_DIR@'

die() { echo "vmtool-thin: $*" >&2; exit 1; }

# The image directory must have been rendered by deploy.
pool_dir=${pool_dir%/}
[[ $pool_dir == /* && $pool_dir =~ ^/[A-Za-z0-9._/-]+$ ]] || die "image directory not configured"
case "$pool_dir/" in */../*) die "image directory not configured" ;; esac

name_re='^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$'
tag_re='^vmtool_[a-z0-9_]+(=[A-Za-z0-9._:-]+)?$'
bytes_re='^[1-9][0-9]{0,17}$'
src_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
export_re='^vmexp-[0-9a-f]{12}$'
measure_re='"fully-allocated"[[:space:]]*:[[:space:]]*([0-9]+)'
endoff_re='"image-end-offset"[[:space:]]*:[[:space:]]*([0-9]+)'

reserved=(snapshot pvmove _cdata _cmeta _corig _mlog _mimage _pmspare _rimage _rmeta _tdata _tmeta _vorigin _vdata)

# need_args exact|min N: the verb's argument count.
need_args() {
  if [[ $1 == exact ]]; then
    [[ $nargs -eq $2 ]] || die "$verb: wrong number of arguments"
  else
    [[ $nargs -ge $2 ]] || die "$verb: wrong number of arguments"
  fi
}

check_vg() {
  [[ $1 =~ $name_re ]] || die "invalid volume group name"
}

check_lv_name() {
  local n=$1 s
  [[ $n =~ $name_re ]] || die "invalid volume name"
  for s in "${reserved[@]}"; do
    [[ $n != *"$s"* ]] || die "volume name uses a name LVM reserves"
  done
}

check_bytes() {
  [[ $1 =~ $bytes_re ]] || die "BYTES must be a positive integer"
}

# has_tag "<comma list>" TAG: an exact element of the list.
has_tag() {
  [[ ",$1," == *",$2,"* ]]
}

# load_vg VG: the VG's visible LVs, one "name|attr|size|tags" line each.
load_vg() {
  listing=$(lvs --noheadings --units b --nosuffix --separator '|' -o lv_name,lv_attr,lv_size,lv_tags "$1" 2>/dev/null) \
    || die "cannot list the volume group"
}

# find_lv NAME (after load_vg): sets L_attr, L_size, L_tags; false if absent.
find_lv() {
  local n a s t
  L_attr='' L_size='' L_tags=''
  while IFS='|' read -r n a s t; do
    n=${n// /}
    if [[ $n == "$1" ]]; then
      L_attr=${a// /}
      L_size=${s// /}
      L_size=${L_size%%.*}
      L_tags=${t// /}
      return 0
    fi
  done <<<"$listing"
  return 1
}

# A pool: a thin-pool LV carrying the vmtool_thinpool tag.
is_pool() {
  [[ $L_attr == t* ]] && has_tag "$L_tags" vmtool_thinpool
}

# vg_has_pool (after load_vg).
vg_has_pool() {
  local n a s t
  while IFS='|' read -r n a s t; do
    a=${a// /}
    t=${t// /}
    if [[ $a == t* ]] && has_tag "$t" vmtool_thinpool; then
      return 0
    fi
  done <<<"$listing"
  return 1
}

# require_pool_vg VG: the VG is valid, listable and holds a pool.
require_pool_vg() {
  check_vg "$1"
  load_vg "$1"
  vg_has_pool || die "volume group holds no vmtool thin pool"
}

# require_target NAME (after require_pool_vg): a vmtool-tagged LV, not a pool.
require_target() {
  check_lv_name "$1"
  find_lv "$1" || die "no such volume: $1"
  if [[ $L_attr == t* ]] || has_tag "$L_tags" vmtool_thinpool; then
    die "$1 is a thin pool"
  fi
  if ! has_tag "$L_tags" vmtool_vol && ! has_tag "$L_tags" vmtool_template && ! has_tag "$L_tags" vmtool_building; then
    die "$1 is not a vmtool volume"
  fi
  # Everything vmtool makes is a thin volume; a tagged thick LV is not ours.
  [[ $L_attr == V* ]] || die "$1 is not a thin volume"
}

# require_export NAME (after require_pool_vg): a thick LV tagged vmtool_export.
require_export() {
  check_lv_name "$1"
  find_lv "$1" || die "no such volume: $1"
  has_tag "$L_tags" vmtool_export || die "$1 is not a vmtool export volume"
  [[ $L_attr == -* ]] || die "$1 is not a thick volume"
}

# require_target_or_export NAME: what remove and tag act on.
require_target_or_export() {
  check_lv_name "$1"
  if find_lv "$1" && has_tag "$L_tags" vmtool_export; then
    require_export "$1"
  else
    require_target "$1"
  fi
}

# require_new NAME (after require_pool_vg): a valid name nothing uses yet.
require_new() {
  check_lv_name "$1"
  if find_lv "$1"; then
    die "$1 already exists"
  fi
}

# new_tags TAG...: validates tags to add to a new LV, fills tag_args.
new_tags() {
  local t kind=no
  tag_args=()
  for t in "$@"; do
    [[ $t =~ $tag_re ]] || die "invalid tag"
    [[ ${t%%=*} != vmtool_thinpool ]] || die "the pool tag cannot be set here"
    [[ ${t%%=*} != vmtool_export && ${t%%=*} != vmtool_bytes ]] || die "the export tags cannot be set here"
    case $t in
      vmtool_vol | vmtool_template | vmtool_building) kind=yes ;;
    esac
    tag_args+=(--addtag "$t")
  done
  [[ $kind == yes ]] || die "a new volume needs a vmtool_vol, vmtool_template or vmtool_building tag"
}

# export_tags TAG...: validates an export volume's tags, fills tag_args.
export_tags() {
  local t has=no
  tag_args=()
  for t in "$@"; do
    [[ $t =~ $tag_re ]] || die "invalid tag"
    case ${t%%=*} in
      vmtool_thinpool | vmtool_vol | vmtool_template | vmtool_building | vmtool_bytes)
        die "that tag cannot be set on an export volume"
        ;;
      vmtool_export) [[ $t == vmtool_export ]] || die "invalid tag"; has=yes ;;
    esac
    tag_args+=(--addtag "$t")
  done
  [[ $has == yes ]] || die "an export volume needs the vmtool_export tag"
}

# src_path PATH: SRC is exactly <image dir>/<file>, a regular file, no symlink.
src_path() {
  local f
  [[ $1 == "$pool_dir"/* ]] || die "source is not in the image directory"
  f=${1#"$pool_dir"/}
  [[ $f =~ $src_re ]] || die "source is not a plain file name in the image directory"
  [[ -f $1 && ! -L $1 ]] || die "source is not a regular file"
}

# import, export and send hand an LV's device node (/dev/VG/NAME, a link
# root's udev made) to vmtool while qemu-img or dd runs, and a trap gives
# each back on every exit path. give_dev LVNAME records and hands over;
# nothing else is chowned, and never a path in the image directory.
owned=()
give_dev() {
  owned+=("$1")
  chown vmtool:vmtool "/dev/$vg/$1"
}
restore_dev() {
  local n
  for n in ${owned[@]+"${owned[@]}"}; do
    chown root:disk "/dev/$vg/$n" || true
  done
  owned=()
}

# export's trap: the nodes back, then the new volume removed if the export
# did not finish. created is set only once lvcreate has succeeded, and names
# only the new volume.
created=no
export_exit() {
  restore_dev
  if [[ $created == yes ]]; then
    created=no
    lvremove -y "$vg/$name" >/dev/null 2>&1 || true
  fi
}

traps() {
  trap "$1" EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

[[ $# -ge 1 ]] || die "usage: vmtool-thin VERB [ARGS]"
verb=$1
shift
nargs=$#

case $verb in
  report)
    need_args exact 0
    all=$(lvs --noheadings --separator '|' -o vg_name,lv_attr,lv_tags 2>/dev/null) || die "cannot list volume groups"
    vgs=()
    seen=' '
    while IFS='|' read -r v a t; do
      v=${v// /}
      a=${a// /}
      t=${t// /}
      [[ $v =~ $name_re ]] || continue
      [[ $a == t* ]] && has_tag "$t" vmtool_thinpool || continue
      [[ $seen != *" $v "* ]] || continue
      seen+="$v "
      vgs+=("$v")
    done <<<"$all"
    if ((${#vgs[@]} == 0)); then
      echo '{"report": [{"lv": []}]}'
      exit 0
    fi
    exec lvs --reportformat json --units b --nosuffix -o lv_name,vg_name,lv_attr,lv_size,pool_lv,origin,data_percent,metadata_percent,lv_tags,lv_time "${vgs[@]}"
    ;;

  create)
    need_args min 5
    vg=$1 pool=$2 name=$3 bytes=$4
    shift 4
    require_pool_vg "$vg"
    check_lv_name "$pool"
    find_lv "$pool" && is_pool || die "not the vmtool thin pool"
    require_new "$name"
    check_bytes "$bytes"
    new_tags "$@"
    lvcreate -V "${bytes}b" --thin -n "$name" "${tag_args[@]}" "$vg/$pool" >/dev/null
    ;;

  snapshot)
    need_args min 4
    vg=$1 src=$2 name=$3
    shift 3
    require_pool_vg "$vg"
    require_target "$src"
    [[ $L_attr == V* ]] || die "$src is not a thin volume"
    require_new "$name"
    new_tags "$@"
    lvcreate -s -kn -n "$name" "${tag_args[@]}" "$vg/$src" >/dev/null
    lvchange -ay "$vg/$name" >/dev/null
    ;;

  extend)
    need_args exact 3
    vg=$1 name=$2 bytes=$3
    require_pool_vg "$vg"
    require_target "$name"
    check_bytes "$bytes"
    [[ $L_size =~ ^[0-9]{1,18}$ ]] || die "cannot read the size of $name"
    if ((10#$bytes < 10#$L_size)); then
      die "BYTES is smaller than the current size of $name"
    fi
    if ((10#$bytes > 10#$L_size)); then
      lvextend -L "${bytes}b" "$vg/$name" >/dev/null
    fi
    ;;

  remove)
    need_args exact 2
    vg=$1 name=$2
    require_pool_vg "$vg"
    require_target_or_export "$name"
    lvremove -y "$vg/$name" >/dev/null
    ;;

  rename)
    need_args exact 3
    vg=$1 old=$2 new=$3
    require_pool_vg "$vg"
    require_target "$old"
    require_new "$new"
    lvrename "$vg" "$old" "$new" >/dev/null
    ;;

  tag)
    need_args min 3
    vg=$1 name=$2
    shift 2
    require_pool_vg "$vg"
    require_target_or_export "$name"
    tag_args=()
    for item in "$@"; do
      t=${item:1}
      [[ $t =~ $tag_re ]] || die "invalid tag"
      [[ ${t%%=*} != vmtool_thinpool ]] || die "the pool tag cannot be changed"
      [[ ${t%%=*} != vmtool_export && ${t%%=*} != vmtool_bytes ]] || die "the export tags cannot be changed here"
      case $item in
        +*) tag_args+=(--addtag "$t") ;;
        -*) tag_args+=(--deltag "$t") ;;
        *) die "tags are given as +TAG or -TAG" ;;
      esac
    done
    lvchange "${tag_args[@]}" "$vg/$name" >/dev/null
    ;;

  import)
    need_args exact 3
    vg=$1 name=$2 src=$3
    require_pool_vg "$vg"
    require_target "$name"
    src_path "$src"
    traps restore_dev
    give_dev "$name"
    setpriv --reuid=vmtool --regid=vmtool --init-groups -- qemu-img convert -f qcow2 -n -O raw -t none -W "$src" "/dev/$vg/$name" >/dev/null
    ;;

  export)
    need_args min 5
    vg=$1 tpl=$2 name=$3
    shift 3
    require_pool_vg "$vg"
    # The pool's size, for the reserve.
    pool_size=''
    while IFS='|' read -r n a s t; do
      a=${a// /}
      t=${t// /}
      if [[ $a == t* ]] && has_tag "$t" vmtool_thinpool; then
        s=${s// /}
        pool_size=${s%%.*}
        break
      fi
    done <<<"$listing"
    [[ $pool_size =~ ^[0-9]{1,18}$ ]] || die "cannot read the size of the thin pool"
    require_target "$tpl"
    has_tag "$L_tags" vmtool_template || die "$tpl is not a vmtool template"
    [[ $name =~ $export_re ]] || die "an export volume is named vmexp- and 12 lower-case hex digits"
    require_new "$name"
    export_tags "$@"
    traps export_exit
    give_dev "$tpl"
    measured=$(setpriv --reuid=vmtool --regid=vmtool --init-groups -- qemu-img measure -f raw -O qcow2 --output=json "/dev/$vg/$tpl") \
      || die "measuring the template failed"
    [[ $measured =~ $measure_re ]] || die "cannot read the measured size"
    need=${BASH_REMATCH[1]}
    sizes=$(vgs --noheadings --units b --nosuffix --separator '|' -o vg_free,vg_extent_size "$vg" 2>/dev/null) \
      || die "cannot read the free space of the volume group"
    IFS='|' read -r free extent <<<"$sizes"
    free=${free// /}
    free=${free%%.*}
    extent=${extent// /}
    extent=${extent%%.*}
    [[ $free =~ ^[0-9]{1,18}$ && $extent =~ $bytes_re ]] || die "cannot read the free space of the volume group"
    [[ $need =~ ^[0-9]{1,18}$ && $need != 0* ]] || die "cannot read the measured size"
    need=$(((10#$need + 10#$extent - 1) / 10#$extent * 10#$extent))
    reserve=$((10#$pool_size / 10))
    if ((10#$free < need + reserve)); then
      die "no room: need=$need free=$free reserve=$reserve"
    fi
    lvcreate -L "${need}b" -n "$name" "${tag_args[@]}" "$vg" >/dev/null
    created=yes
    give_dev "$name"
    setpriv --reuid=vmtool --regid=vmtool --init-groups -- qemu-img convert -p -f raw -O qcow2 -t none -W -m 16 "/dev/$vg/$tpl" "/dev/$vg/$name"
    checked=$(setpriv --reuid=vmtool --regid=vmtool --init-groups -- qemu-img check --output=json "/dev/$vg/$name") \
      || die "checking the export failed"
    [[ $checked =~ $endoff_re ]] || die "cannot read the image length"
    len=${BASH_REMATCH[1]}
    [[ $len =~ $bytes_re ]] && ((10#$len <= need)) || die "the image length is not usable"
    lvchange --addtag "vmtool_bytes=$len" "$vg/$name" >/dev/null
    created=no
    ;;

  send)
    need_args exact 2
    vg=$1 name=$2
    require_pool_vg "$vg"
    require_export "$name"
    # The length is the volume's own vmtool_bytes tag, once, and nothing else.
    len='' ntag=0
    IFS=, read -ra tags <<<"$L_tags"
    for t in "${tags[@]}"; do
      if [[ $t == vmtool_bytes=* ]]; then
        len=${t#vmtool_bytes=}
        ntag=$((ntag + 1))
      fi
    done
    ((ntag == 1)) || die "$name has no single vmtool_bytes tag"
    [[ $len =~ $bytes_re ]] || die "the vmtool_bytes tag is not a length"
    [[ $L_size =~ ^[0-9]{1,18}$ ]] || die "cannot read the size of $name"
    ((10#$len <= 10#$L_size)) || die "the vmtool_bytes tag is larger than $name"
    traps restore_dev
    give_dev "$name"
    setpriv --reuid=vmtool --regid=vmtool --init-groups -- dd "if=/dev/$vg/$name" bs=1M "count=$len" iflag=count_bytes,fullblock status=none
    ;;

  *)
    die "unknown verb"
    ;;
esac
