#!/bin/bash
# vmtool-net: the one root-owned helper through which the vmtool daemon makes
# the VXLAN links between hosts' vmtool networks.
#
#   sudo -n /usr/local/libexec/vmtool-net <verb> <args>
#
# Installed by `just deploy` (scripts/deploy.sh) as root:root 0755, never
# owned by the vmtool user, with a sudoers rule that lets user vmtool run
# this one file as root. The daemon may be compromised, so every argument is
# validated here and the helper acts only on devices it names itself:
#   - the VXLAN device vx<VNI>, made, replaced and removed here and nowhere
#     else; its master is a bridge vmt-<six hex digits> that exists and whose
#     digits are the VNI (vmtool's rule: the bridge name carries the VNI);
#   - flood entries on that device and no other;
#   - report only reads.
# It never passes a caller-supplied option to ip or bridge: every value is
# checked against a fixed pattern before it is used, and none can start with
# a dash. libvirt work (networks, bridges, cards) stays with the daemon as
# user vmtool; this helper never runs virsh.
#
# Verbs (a refusal prints one line to stderr and exits non-zero):
#   link VNI BRIDGE LOCAL_IP DEV PEER...   make or replace vx<VNI>, flood to
#                                          exactly the PEERs, master it to
#                                          BRIDGE, bring it up; idempotent
#   unlink VNI                             remove vx<VNI> (none: success)
#   report                                 {"links":<ip JSON>,"fdb":<bridge JSON>}
#
# VNI is 1..16777215, decimal, no leading zero. BRIDGE must be vmt- plus six
# lowercase hex digits equal to the VNI, and exist as a bridge. LOCAL_IP and
# each PEER are dotted-quad IPv4 addresses (no 0.x, 127.x or 224 and up; a
# peer is never LOCAL_IP). DEV is an existing interface that is not lo,
# vmt-*, vx*, virbr* or vnet*, at most 15 characters. Any number of PEERs,
# none included; a repeated peer is added once. link leaves an existing
# vx<VNI> with the same VNI, local address, DEV, port 4789 and BRIDGE in place
# (no delete, no traffic gap) and only sets its flood entries to exactly the
# ones given; a device with other settings is deleted and made again. A step
# that fails after a device was made deletes it again. link and the removal
# verb hold an exclusive flock on a fixed file, /run/vmtool-net.lock, for
# their whole run, so two callers never interleave; report holds it shared, so
# it never sees a device another call is half-way through making. The lock
# file is opened without truncating, and a path that is a symlink or not a
# regular file is refused. report runs each of its two listings up to 5 times
# (0.2 s apart) when one exits non-zero: ip has been seen to crash (SIGSEGV)
# listing links while a device is being made.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
umask 022

# Where interfaces are looked up (the one line a test rewrites).
sysnet=/sys/class/net

# The one lock file link and the removal verb hold (exclusive) and report
# holds (shared) for their whole run. /run is root-only, so no other user can
# pre-create it. Fixed path; the line a test rewrites.
lockfile=/run/vmtool-net.lock

# The pause between the tries of report's listings (a test rewrites this line).
retry_pause=0.2

die() { echo "vmtool-net: $*" >&2; exit 1; }

dev_re='^[A-Za-z0-9][A-Za-z0-9._-]{0,14}$'
ipv4_re='^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$'

# check_vni V: decimal 1..16777215, no leading zero.
check_vni() {
  [[ $1 =~ ^[1-9][0-9]{0,7}$ ]] && (( $1 <= 16777215 )) || die "invalid VNI"
}

# check_ipv4 WHAT ADDR: a usable unicast IPv4 address.
check_ipv4() {
  local what=$1 a=$2 i
  [[ $a =~ $ipv4_re ]] || die "invalid $what"
  local o=("${BASH_REMATCH[@]:1}")
  for i in 0 1 2 3; do
    (( o[i] <= 255 )) || die "invalid $what"
  done
  (( o[0] != 0 && o[0] != 127 && o[0] < 224 )) || die "invalid $what"
}

# take_lock [-s]: the lock on fd 9 (exclusive; shared with -s), held until
# the helper exits. A symlink or anything but a regular file at the path is
# refused before it is opened; the file is opened read-write without
# truncating (created if missing) and the open file is checked again, which
# narrows the check-then-open gap (only root can write in /run anyway).
take_lock() {
  if [[ -L $lockfile ]] || { [[ -e $lockfile ]] && [[ ! -f $lockfile ]]; }; then
    die "the lock file is not a regular file"
  fi
  exec 9<>"$lockfile" || die "cannot open the lock file"
  [[ -f /dev/fd/9 && ! -L $lockfile ]] || die "the lock file is not a regular file"
  flock "$@" 9 || die "cannot take the lock"
}

# list_retry VAR CMD...: run CMD up to 5 times, retry_pause apart, while it
# exits non-zero; its output goes to VAR. Returns 1 after the last try.
list_retry() {
  local __var=$1 __out __try
  shift
  for __try in 1 2 3 4 5; do
    if __out=$("$@"); then
      printf -v "$__var" '%s' "$__out"
      return 0
    fi
    (( __try == 5 )) || sleep "$retry_pause"
  done
  return 1
}

verb=${1:-}
[[ -n $verb ]] || die "usage: link|unlink|report"
shift
nargs=$#

case "$verb" in
  link)
    (( nargs >= 4 )) || die "link: wrong number of arguments"
    vni=$1 bridge=$2 local_ip=$3 dev=$4
    shift 4
    check_vni "$vni"
    [[ $bridge =~ ^vmt-[0-9a-f]{6}$ ]] || die "invalid bridge name"
    printf -v want_bridge 'vmt-%06x' "$vni"
    [[ $bridge == "$want_bridge" ]] || die "bridge does not match the VNI"
    [[ -d $sysnet/$bridge/bridge ]] || die "bridge does not exist"
    check_ipv4 "local address" "$local_ip"
    [[ $dev =~ $dev_re ]] || die "invalid interface"
    case "$dev" in
      lo|vmt-*|vx*|virbr*|vnet*) die "interface not allowed" ;;
    esac
    [[ -e $sysnet/$dev ]] || die "interface does not exist"
    peers=()
    for p in "$@"; do
      check_ipv4 "peer address" "$p"
      [[ $p != "$local_ip" ]] || die "peer is the local address"
      seen=
      for q in "${peers[@]+"${peers[@]}"}"; do
        [[ $q != "$p" ]] || seen=1
      done
      [[ -n $seen ]] || peers+=("$p")
    done
    take_lock
    vx="vx$vni"
    if [[ -e $sysnet/$vx ]]; then
      # An existing device with the same VNI, local address, underlay
      # interface, port and bridge is kept (no delete, no traffic gap); only
      # its flood entries are set. Anything else is replaced.
      show=$(ip -d -o link show dev "$vx") || show=
      cur_master= cur_id= cur_local= cur_dev= cur_port=
      if [[ $show =~ [[:space:]]master[[:space:]]([^[:space:]]+) ]]; then cur_master=${BASH_REMATCH[1]}; fi
      if [[ $show =~ [[:space:]]vxlan[[:space:]]id[[:space:]]([0-9]+)[[:space:]]local[[:space:]]([0-9.]+)[[:space:]]dev[[:space:]]([^[:space:]]+) ]]; then
        cur_id=${BASH_REMATCH[1]} cur_local=${BASH_REMATCH[2]} cur_dev=${BASH_REMATCH[3]}
      fi
      if [[ $show =~ [[:space:]]dstport[[:space:]]([0-9]+) ]]; then cur_port=${BASH_REMATCH[1]}; fi
      if [[ $cur_master == "$bridge" && $cur_id == "$vni" && $cur_local == "$local_ip" \
            && $cur_dev == "$dev" && $cur_port == 4789 ]]; then
        flood=$(bridge fdb show dev "$vx") || die "cannot list the flood entries"
        have=()
        while read -r mac w_dst dst _; do
          [[ $mac == 00:00:00:00:00:00 && $w_dst == dst ]] || continue
          check_ipv4 "flood entry" "$dst"
          have+=("$dst")
        done <<<"$flood"
        for h in "${have[@]+"${have[@]}"}"; do
          keep=
          for p in "${peers[@]+"${peers[@]}"}"; do
            [[ $p != "$h" ]] || keep=1
          done
          [[ -n $keep ]] || bridge fdb del 00:00:00:00:00:00 dev "$vx" dst "$h" \
            || die "cannot remove a flood entry"
        done
        for p in "${peers[@]+"${peers[@]}"}"; do
          present=
          for h in "${have[@]+"${have[@]}"}"; do
            [[ $p != "$h" ]] || present=1
          done
          [[ -n $present ]] || bridge fdb append 00:00:00:00:00:00 dev "$vx" dst "$p" \
            || die "cannot add a flood entry"
        done
        ip link set "$vx" up || die "cannot bring the device up"
        exit 0
      fi
      ip link del "$vx" || die "cannot remove the old device"
    fi
    ip link add "$vx" type vxlan id "$vni" dstport 4789 local "$local_ip" dev "$dev" \
      || die "cannot make the device"
    # From here a failure removes the device we made.
    fail() { ip link del "$vx" >/dev/null 2>&1 || true; die "$1"; }
    ip link set "$vx" master "$bridge" || fail "cannot attach the device to the bridge"
    for p in "${peers[@]+"${peers[@]}"}"; do
      bridge fdb append 00:00:00:00:00:00 dev "$vx" dst "$p" || fail "cannot add a flood entry"
    done
    ip link set "$vx" up || fail "cannot bring the device up"
    ;;
  unlink)
    (( nargs == 1 )) || die "unlink: wrong number of arguments"
    check_vni "$1"
    take_lock
    if [[ -e $sysnet/vx$1 ]]; then
      ip link del "vx$1" || die "cannot remove the device"
    fi
    ;;
  report)
    (( nargs == 0 )) || die "report: wrong number of arguments"
    take_lock -s
    list_retry links ip -j -d link show type vxlan || die "cannot list the links"
    list_retry fdb bridge -j fdb show || die "cannot list the flood entries"
    printf '{"links":%s,"fdb":%s}\n' "$links" "$fdb"
    ;;
  *)
    die "unknown verb"
    ;;
esac
